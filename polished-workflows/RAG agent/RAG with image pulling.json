    {
      "parameters": {
        "jsCode": "// Base where images are served (no trailing slash required)\nconst BASE_URL = 'http://192.168.0.16:8080';\n\n// Leave empty because Nginx serves the extracted-images folder directly at the root\nconst IMAGE_PATH_PREFIX = '';\n\nfunction buildImageUrl(relativeSrc) {\n  const file = String(relativeSrc).trim().replace(/^\\.\\//, '');\n  const base = BASE_URL.replace(/\\/+$/, '');\n  const prefix = IMAGE_PATH_PREFIX.replace(/^\\/+|\\/+$/g, '');\n  const path = prefix ? `${prefix}/${file}` : file;\n  return `${base}/${path.replace(/\\/+/g, '/')}`;\n}\n\nfor (const item of $input.all()) {\n  // FIX 1: Drill down into Docling's 'document' object to find the markdown\n  const md = item.json?.document?.md_content;\n  \n  if (typeof md !== 'string') continue;\n\n  // FIX 2: Write the updated markdown back to that exact nested path\n  item.json.document.md_content = md.replace(\n    /!\\[([^\\]]*)\\]\\(([^)]+)\\)/g,\n    (full, alt, src) => {\n      const s = src.trim();\n      if (/^https?:\\/\\//i.test(s) || s.startsWith('data:') || s.startsWith('//')) {\n        return full;\n      }\n      return `![${alt}](${buildImageUrl(s)})`;\n    }\n  );\n}\n\nreturn $input.all();"
      },
