    {
      "parameters": {
        "jsCode": "// Extract image file names from markdown content in each input item\nfor (const item of $input.all()) {\n  const md = item.json?.document?.md_content ?? \"\";\n\n  // Matches: ![Image](some_file_name.png)\n  const matches = [...md.matchAll(/!\\[[^\\]]*]\\(([^)\\s]+)\\)/g)];\n  const imageNames = matches.map((m) => m[1]);\n\n  // Add new field to each item\n  item.json.imageNames = imageNames;\n  item.json.imageCount = imageNames.length;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
